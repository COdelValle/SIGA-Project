{
  "name": "ms-evaluaciones",
  "projectType": "application",
  "implicitDependencies": ["core-share", "ms-asignaturas"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/backend/ms-evaluaciones",
        "command": "./mvnw clean package -DskipTests"
      }
    },
    "docker-build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "docker buildx build --platform linux/amd64 -t $MS_ASIGN_ECR:$TAG_VERSION -t $MS_ASIGN_ECR:latest apps/backend/ms-evaluaciones --push"
      }
    }
  }
}
