{
  "name": "ms-estudiantes",
  "projectType": "application",
  "implicitDependencies": ["core-share"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/backend/ms-estudiantes",
        "command": "./mvnw clean package -DskipTests"
      }
    },
    "docker-build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "docker buildx build --platform linux/amd64 -t $MS_EST_ECR:$TAG_VERSION -t $MS_EST_ECR:latest apps/backend/ms-estudiantes --push"
      }
    }
  }
}