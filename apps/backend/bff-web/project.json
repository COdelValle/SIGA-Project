{
  "name": "bff-web",
  "projectType": "application",
  "implicitDependencies": ["core-share"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/backend/bff-web",
        "command": "./mvnw clean package -DskipTests"
      }
    },
    "docker-build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "docker buildx build --platform linux/amd64 -t $BFF_WEB_ECR:$TAG_VERSION -t $BFF_WEB_ECR:latest apps/backend/bff-web --push"
      }
    }
  }
}