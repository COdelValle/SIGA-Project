// Copiar a terraform.tfvars (gitignored) y ajustar.
// NO poner secretos aquí: las credenciales de la app (DB, Azure) van en los
// secretos de GitHub y se escriben en el .env del servidor durante el CD.

aws_region       = "us-east-1"
management_name  = "SIGA"
key_name         = "vockey"
instance_type    = "t3.medium"
data_volume_size = 10
ssh_cidr         = "0.0.0.0/0"

// Verificar con jwt.ms / jwt.io decodificando un access token real antes de
// aplicar. Un token v2 trae aud = GUID y issuer .../v2.0; un token v1 trae
// aud = api://<client-id> y issuer https://sts.windows.net/<tenant>/. Se aceptan
// ambos audiences para no depender de la version.
azure_audience = [
  "448f165b-4fab-45c4-9088-766044e1a004",
  "api://448f165b-4fab-45c4-9088-766044e1a004",
]
azure_issuer = "https://login.microsoftonline.com/f260a804-82ac-4b57-bb01-9ed6626d71ff/v2.0"
