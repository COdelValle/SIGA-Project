# AMI de Ubuntu 22.04 LTS (Canonical). Este data source es el que faltaba en el
# experimento anterior (se referenciaba data.aws_ami.ubuntu sin declararlo).
data "aws_ami" "ubuntu" {
  most_recent = true
  owners      = ["099720109477"]

  filter {
    name   = "name"
    values = ["ubuntu/images/hvm-ssd/ubuntu-jammy-22.04-amd64-server-*"]
  }

  filter {
    name   = "virtualization-type"
    values = ["hvm"]
  }

  filter {
    name   = "architecture"
    values = ["x86_64"]
  }
}
