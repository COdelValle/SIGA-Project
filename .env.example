# Copiar este archivo a .env y completar los valores.
# .env NO se versiona (está en .gitignore).

# --- MariaDB (una instancia por microservicio) ---
MARIADB_ROOT_PASSWORD=change_me_root
DB_USER=siga
DB_PASS=change_me

# --- Azure AD / Entra ID (OAuth2 JWT) ---
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_APP_ID_URI=api://<client-id>

# --- Microsoft Graph (pre-registro de usuarios y sincronización de roles) ---
# Secreto de cliente de la app de API. Si queda vacío, la integración con Graph
# queda deshabilitada (el CRUD de usuarios sigue funcionando).
AZURE_CLIENT_SECRET=
# App id (GUID) de la app que define los app roles ADMIN/DOCENTE/APODERADO/ESTUDIANTE.
# Si se omite, se usa AZURE_CLIENT_ID.
AZURE_API_APP_ID=
