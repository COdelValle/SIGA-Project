# Copiar este archivo a .env y completar los valores.
# .env NO se versiona (está en .gitignore).

# --- MariaDB (una instancia por microservicio en local) ---
MARIADB_ROOT_PASSWORD=change_me_root
DB_USER=siga_user
DB_PASS=change_me

# --- RabbitMQ (mensajeria entre microservicios) ---
RABBITMQ_USER=siga_rabbit
RABBITMQ_PASS=change_me_rabbit
# Cookie Erlang compartida por los dos nodos del clúster (debe ser idéntica).
# Generar una propia, por ejemplo: openssl rand -hex 32
RABBITMQ_ERLANG_COOKIE=change_me_cookie

# --- Azure AD / Entra ID (OAuth2 JWT) ---
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_APP_ID_URI=api://<client-id>

# --- Microsoft Graph (pre-registro de usuarios y sincronización de roles) ---
# Secreto de cliente de la app de API. Si queda vacío, la integración con Graph
# queda deshabilitada (el CRUD de usuarios sigue funcionando).
AZURE_CLIENT_SECRET=
# App id (GUID) de la app que define los app roles ADMIN/DOCENTE/APODERADO/ESTUDIANTE.
# Si se omite, se usa AZURE_CLIENT_ID.
AZURE_API_APP_ID=

# --- Registro asíncrono de usuarios (ms-usuarios-auth) ---
# Crea la cuenta en Entra ID (clave temporal con cambio obligatorio) y el perfil
# del rol de forma asíncrona. Requiere Graph configurado (AZURE_CLIENT_SECRET) y,
# para habilitarlo, una clave AES-256 en Base64 (32 bytes) que cifra la credencial
# temporal en reposo. Generar con: openssl rand -base64 32
REGISTRO_ASYNC_ENABLED=false
REGISTRO_CRED_KEY=
# Emite un aviso user.credentials.notify cuando la cuenta queda creada; queda
# reservado para el futuro servicio que entregará la clave por correo.
REGISTRO_NOTIFY_CREDENTIALS_ENABLED=false
# Dominio del correo institucional que se genera desde el nombre del usuario.
REGISTRO_EMAIL_DOMAIN=platformsiga.onmicrosoft.com
